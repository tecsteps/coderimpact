OPENROUTER_API_KEY=
# The model explanations use (any OpenRouter model id)
OPENROUTER_MODEL=openai/gpt-6-luna
# OpenRouter reasoning.effort: max, xhigh, high, medium, low, minimal or none
OPENROUTER_REASONING_EFFORT=none
# Only for deploying with wrangler:
CLOUDFLARE_API_KEY=
# Local SonarQube analysis (npm run sonar)
SONAR_TOKEN=
# Sign in with GitHub (private repositories): the GitHub App's client id, slug and secret
GITHUB_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_SECRET=
