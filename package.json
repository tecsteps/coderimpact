{
  "name": "coderimpact",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-legal.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "discover-models": "node scripts/discover-models.mjs",
    "relay": "node relay/server.mjs",
    "predev": "node scripts/copy-grammars.mjs",
    "prebuild": "node scripts/copy-grammars.mjs",
    "pretest": "node scripts/copy-grammars.mjs",
    "build:artifact": "node scripts/copy-grammars.mjs artifact/public/grammars && vite build --mode artifact && node scripts/artifact-page.mjs",
    "snapshots": "node scripts/build-snapshot.mjs spf13/cobra && node scripts/build-snapshot.mjs slimphp/Slim 4.x",
    "sonar": "node scripts/sonar.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
